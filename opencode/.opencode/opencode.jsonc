{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "mcp-gateway": {
      "type": "remote",
      "url": "http://mcp-gateway.docker.internal/mcp",
      "enabled": true,
      "headers": {
        "Authorization": "Bearer proxy-managed"
      }
    }
  },
  // configuration du provider local Ollama LAN
  // "provider": {
  //   "ollama": {
  //     "npm": "@ai-sdk/openai-compatible",
  //     "name": "Ollama LAN",
  //     "options": {
  //       "baseURL": "http://{env:OLLAMA_HOST}:11434/v1",
  //       "timeout": 600000
  //     },
  //     "models": {
  //       "qwen3.5:4b": {
  //         "name": "qwen3.5:4b (local)"
  //       }
  //     }
  //   }
  // },
  // "model": "ollama/qwen3.5:4b",
  // "small_model": "ollama/qwen3.5:4b",
  "model": "opencode/big-pickle",
  "small_model": "opencode/big-pickle",
  "share": "disabled",
  "permission": {
    // comportement par défaut pour les agents et les skills
    // peuvent être surchargés par des permissions d'agents
    "*": "ask",
    "edit": {
      "*": "ask",
      "example/ECommerce.Api/*.cs": "allow",
      "example/ECommerce.Api/**/*.cs": "allow",
      "example/ECommerce.Tests/**/*.cs": "allow"
    },
    // gestion des fichiers sensibles obligatoire si pas chiffrement !!!
    "read": {
      "*": "allow",
      ".env*": "deny",
      ".env.schema": "allow"
    },
    "bash": {
      "*": "ask",
      "ls*": "allow",
      "find*": "allow",
      "git *": "allow",
      "git push*": "ask",
      "cat *": "allow",
      "cat .env.*": "deny",
      "dotnet test*": "allow"
    },
    "glob": {
      "*": "allow",
      ".env*": "deny"
    },
    "grep": {
      "*": "allow",
      ".env*": "deny"
    },
    "task": "allow",
    "skill": {
      "*": "allow"
    },
    "webfetch": "allow"
  }
}